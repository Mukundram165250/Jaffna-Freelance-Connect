NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:3000

# PostgreSQL connection string used by Prisma.
# Example: postgresql://USER:PASSWORD@HOST:5432/jaffna_freelance_connect?schema=public
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/jaffna_freelance_connect?schema=public"

JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="7d"
AUTH_COOKIE_NAME="jfc_auth"
AUTH_COOKIE_MAX_AGE_MS=604800000
BCRYPT_ROUNDS=12
